# Environment Variables untuk NALAR Stack

DOMAIN=bangkit.io
NALAR_SUBDOMAIN=nalar.bangkit.io
AUTH_SUBDOMAIN=auth.bangkit.io
EMAIL_LETSENCRYPT=admin@bangkit.io

# Path direktori repository / project Anda di host VPS yang ingin diakses oleh NALAR
HOST_PROJECTS_DIR=./projects

# Secrets (dihasilkan otomatis oleh ./deploy.sh)
JWT_SECRET=nalar_jwt_random_secret_32_characters_long_min
SESSION_SECRET=nalar_session_random_secret_32_characters_long
STORAGE_ENCRYPTION_KEY=nalar_storage_random_key_32_characters_long
