# Environment Variables untuk NALAR Stack (Coolify Traefik Integration)

DOMAIN=bangkit.io
NALAR_SUBDOMAIN=nalar.bangkit.io
AUTH_SUBDOMAIN=auth.bangkit.io

# Direktori project di host VPS yang bisa dibuka di NALAR (/workspace)
HOST_PROJECTS_DIR=/root

# Path Traefik dynamic config milik Coolify
TRAEFIK_DYNAMIC_DIR=/data/coolify/proxy/dynamic

# Secrets (dihasilkan otomatis oleh ./deploy.sh)
JWT_SECRET=ganti_otomatis_oleh_deploy_sh
SESSION_SECRET=ganti_otomatis_oleh_deploy_sh
STORAGE_ENCRYPTION_KEY=ganti_otomatis_oleh_deploy_sh
