# Fast, production-ready Dockerfile for NALAR (Branded T3 Code Harness)
FROM node:22-bookworm-slim

ARG T3_VERSION=0.1.10

# Install dev tools and agent runtime utilities
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    openssh-client \
    tmux \
    python3 \
    ripgrep \
    jq \
    procps \
    tar \
    gzip \
    unzip \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Download prebuilt T3 Code Linux x64 release into /opt/nalar
RUN mkdir -p /opt/nalar && \
    curl -fsSL "https://github.com/pingdotgg/t3code/releases/download/v${T3_VERSION}/t3-${T3_VERSION}-linux-x64.tar.gz" \
    | tar -xz --strip-components=1 -C /opt/nalar && \
    chmod +x /opt/nalar/t3 && \
    ln -sf /opt/nalar/t3 /usr/local/bin/t3 && \
    ln -sf /opt/nalar/t3 /usr/local/bin/nalar

# Pre-install popular AI coding agent CLIs (Claude Code & OpenAI Codex)
RUN npm install -g @anthropic-ai/claude-code @openai/codex && npm cache clean --force

# Apply full NALAR branding (SVG logo, favicon, splash screen, PWA manifest, UI text)
COPY brand-nalar.py /opt/nalar/brand-nalar.py
RUN python3 /opt/nalar/brand-nalar.py

# Persistent data/home & workspace mount points
RUN mkdir -p /data/home /data/t3 /workspace
WORKDIR /workspace

ENV HOME=/data/home
ENV T3CODE_HOME=/data/t3
ENV T3CODE_HOST=0.0.0.0
ENV T3CODE_PORT=3773
ENV T3CODE_NO_BROWSER=true
ENV NODE_ENV=production

EXPOSE 3773

CMD ["/opt/nalar/t3", "serve", "--host", "0.0.0.0", "--port", "3773", "--base-dir", "/data/t3"]
