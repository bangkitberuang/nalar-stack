###############################################################
#             Authelia Users Database for NALAR               #
###############################################################
# Generate hash password di VPS dengan perintah:
# docker run --rm -it authelia/authelia:4.38 authelia crypto hash generate argon2

users:
  admin:
    displayname: "Owner NALAR"
    # Salin hasil "Digest: $argon2id$..." dari perintah di atas ke baris bawah:
    password: "$argon2id$v=19$m=65536,t=3,p=4$isi_hash_password_disini"
    email: admin@bangkit.io
    groups:
      - admins
      - dev
